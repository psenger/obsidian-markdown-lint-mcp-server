{
  "name": "obsidian-markdown-lint-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for markdown linting, front matter validation, and Mermaid SVG rendering",
  "license": "MIT",
  "author": "Philip Senger",
  "homepage": "https://github.com/psenger/obsidian-markdown-lint-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psenger/obsidian-markdown-lint-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/psenger/obsidian-markdown-lint-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "markdown",
    "markdownlint",
    "obsidian",
    "mermaid",
    "front-matter",
    "json-schema",
    "claude",
    "docker",
    "stdio"
  ],
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/server-http.js",
    "dev": "tsx src/server.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "eval": "tsx tests/evals/eval-runner.ts",
    "snapshot": "tsx tests/snapshot/snapshot-runner.ts"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "markdownlint": "^0.42.2"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-typescript": "^8.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "babel-jest",
        {
          "presets": [
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "testMatch": [
      "**/tests/unit/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/server.ts",
      "!src/server-http.ts",
      "!src/create-server.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 85,
        "functions": 90,
        "statements": 90
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
